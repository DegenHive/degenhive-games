{
  "name": "degenhive-games",
  "private": true,
  "description": "Games on DegenHive: one directory per game, checks, review, edge server and deploy.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test tests/e2e/*.e2e.mjs",
    "checks": "node scripts/checks/run.mjs",
    "edge-dev": "node tools/edge-dev/server.mjs",
    "review": "node scripts/review/review.mjs",
    "deploy": "node scripts/deploy/deploy.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
