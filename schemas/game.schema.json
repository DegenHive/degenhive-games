{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DegenHive/degenhive-games/blob/main/schemas/game.schema.json",
  "title": "game.json",
  "description": "Game metadata. docs/PROTOCOL.md section 3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "slug", "title", "pitch", "owner", "tags", "controls", "mobile", "orientation", "scored", "sdk"],
  "properties": {
    "schema": { "const": 1 },
    "slug": {
      "description": "3 to 32 characters: a-z, 0-9 and -. Starts with a letter, does not end with -, has no --. Fixed after the first merge.",
      "type": "string",
      "pattern": "^(?!.*--)[a-z][a-z0-9-]{1,30}[a-z0-9]$"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "\\S" },
    "pitch": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
    "owner": {
      "description": "The owner's wallet address. Set and changed only by DegenHive.",
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "entry": {
      "description": "A path inside src/.",
      "allOf": [{ "$ref": "#/$defs/path" }, { "pattern": "\\.html?$" }],
      "default": "index.html"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["arcade", "puzzle", "action", "strategy", "racing", "idle", "card", "word", "sports", "shooter", "platformer", "rhythm", "sim", "casual", "multiplayer"]
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["mouse", "keyboard", "touch", "gamepad"] }
    },
    "mobile": { "type": "boolean" },
    "orientation": { "enum": ["landscape", "portrait", "any"] },
    "scored": { "type": "boolean" },
    "scoring": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/scoring" }] },
    "sim": {
      "description": "null, or a path inside src/ to a pure simulation file.",
      "anyOf": [{ "type": "null" }, { "allOf": [{ "$ref": "#/$defs/path" }, { "pattern": "\\.m?js$" }] }]
    },
    "backends": {
      "description": "https:// origins the game connects to. Each one needs a human approval.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+(:[0-9]{1,5})?$"
      }
    },
    "sdk": { "const": 1 }
  },
  "if": { "properties": { "scored": { "const": true } }, "required": ["scored"] },
  "then": { "required": ["scoring"], "properties": { "scoring": { "$ref": "#/$defs/scoring" } } },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)(?!__dh/)[a-z0-9_.\\-/]*[a-z0-9_.\\-]$"
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "maxScore", "maxPointsPerSecond", "minRunSeconds"],
      "properties": {
        "mode": { "enum": ["best", "sum"] },
        "maxScore": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maxPointsPerSecond": { "type": "number", "exclusiveMinimum": 0 },
        "minRunSeconds": { "type": "number", "minimum": 0 }
      }
    }
  }
}
