{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DegenHive/degenhive-games/blob/main/schemas/assets.schema.json",
  "title": "assets.json",
  "description": "Binary files kept outside git, stored by hash. docs/PROTOCOL.md section 2.3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["assets"],
  "properties": {
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "bytes", "type"],
        "properties": {
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "type": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      }
    }
  }
}
